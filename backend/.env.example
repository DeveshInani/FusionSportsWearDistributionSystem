DATABASE_SSL_REQUIRED=true
# Copy this file to .env and set your local MySQL credentials.
DATABASE_URL=mysql+pymysql://avnadmin:REPLACE_WITH_DATABASE_PASSWORD@mysql-1b2a95ca-sportswearsolutionfusion.d.aivencloud.com:25138/defaultdb?charset=utf8mb4
DATABASE_SSL_CA=certs\aiven-ca.pem

# Generate a unique key and set a private bootstrap admin password before startup.
SECRET_KEY=generate-a-unique-random-secret-at-least-32-characters
BOOTSTRAP_ADMIN_EMAIL=store-admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=generate-a-unique-random-password-at-least-16-characters

# Optional real email delivery. Without SMTP_HOST, order emails are written to
# the admin-visible email log as simulated rather than sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=store@example.test
SMTP_USE_TLS=true
ADMIN_NOTIFICATION_EMAIL=
